{
  "manifest_version": 3,
  "name": "실시간 화면 번역 박스",
  "version": "1.0",
  "description": "화면을 가리지 않는 모서리 플로팅 버튼과 실시간 번역 오버레이 툴",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}